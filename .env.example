APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sesiones de la app móvil (JWT Bearer). JWT_SECRET: 32+ caracteres; si falta, se deriva de APP_KEY.
# Generar uno: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200

# Pagos con tarjeta (Mercado Pago). Token: Tus integraciones → tu aplicación → Credenciales.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → tu aplicación → Webhooks → Configurar notificaciones).
# URL del webhook, modo productivo, evento «Pagos»: https://<dominio>/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=

# Textos legales (B-32): false solo mientras la app publicada no maneje legal_update_required
LEGAL_ENFORCE_API=true

# Google (opcionales). Analytics solo se carga si la persona acepta las cookies de analítica.
#   GOOGLE_ANALYTICS_ID: el «ID de medición» de GA4 (G-XXXXXXXXXX).
#   GOOGLE_SITE_VERIFICATION: solo el valor content="..." de la etiqueta meta que da Search Console.
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# CORS: sitios web que pueden llamar a la API desde un navegador, además de APP_URL (separados por comas).
# La app móvil no lo necesita.
CORS_ALLOWED_ORIGINS=

# ── Seguridad en producción (Hostinger) ─────────────────────────────────────────
# En el servidor: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true y
# SESSION_ENCRYPT=true (cifra los datos de sesión guardados en la base).
# MERCADOPAGO_WEBHOOK_SECRET debe estar lleno para validar la firma de los avisos de pago.
#
# Clave para /run-auto-backup si lo llama un cron externo. Vacía = la URL no existe.
# El respaldo ya corre solo con «php artisan schedule:run». Genera una con:
#   php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=
# Segundos que dura la contraseña confirmada para entrar a respaldos y personal
AUTH_PASSWORD_TIMEOUT=900
