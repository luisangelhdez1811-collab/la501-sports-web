# config.php solo debe usarse vía "require" desde los otros scripts de
# esta carpeta, nunca solicitarse directamente por URL.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
