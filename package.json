{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:css",
        "build:css": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/css/tailwind.css --minify",
        "dev": "tailwindcss -c tailwind.config.js -i resources/css/tailwind.css -o public/css/tailwind.css --watch"
    },
    "devDependencies": {
        "concurrently": "^9.0.1",
        "tailwindcss": "^3.4.17"
    }
}
